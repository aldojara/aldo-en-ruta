<footer class="site-footer">
  <div class="container footer-container">
    <!-- Column 1: Brand & Socials -->
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <svg class="logo-icon" viewBox="0 0 40 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 2L36 28H4L20 2Z" stroke="#D4AF37" stroke-width="2.5" stroke-linejoin="round"/>
          <path d="M12 28L20 14L28 28" stroke="#E5C158" stroke-width="2" stroke-linejoin="round"/>
          <circle cx="20" cy="9" r="2.5" fill="#D4AF37"/>
