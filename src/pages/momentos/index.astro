---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Momentos Inmersivos & 360° | Aldo en Ruta" activeNav="Momentos">
  <!-- Hero Section -->
  <section class="momentos-hero">
    <div class="container">
      <span class="badge badge-gold">SELECCIÓN EDITORIAL • MOMENTOS</span>
      <h1 class="hero-title title-serif">Momentos que se quedan contigo.</h1>
      <p class="hero-sub">
        Descubre escenas reales de nuestras rutas: panoramas que impresionan, curvas que retan, pausas que inspiran y paisajes que solo los caminos del Perú pueden regalar.
      </p>

      <div class="hero-actions">
        <a href="#galeria-momentos" class="btn-gold">
          Explorar momentos →
        </a>
        <a href="/rutas/piloto" class="btn-outline-gold">
          Ver ruta relacionada
        </a>
      </div>

      <!-- Quick Stats Bar -->
      <div class="momentos-stats-bar glass-panel">
        <div class="m-stat">
          <div class="m-stat-icon">🌐</div>
          <div>
            <strong>360°</strong>
            <span>Experiencias inmersivas</span>
          </div>
        </div>
        <div class="m-stat">
          <div class="m-stat-icon">🎥</div>
          <div>
            <strong>Vídeo</strong>
            <span>Historias en movimiento</span>
          </div>
        </div>
        <div class="m-stat">
          <div class="m-stat-icon">📷</div>
          <div>
            <strong>Fotografía</strong>
            <span>Instantáneas reales</span>
          </div>
        </div>
        <div class="m-stat">
          <div class="m-stat-icon">🏔️</div>
          <div>
            <strong>Andes</strong>
            <span>Territorios únicos</span>
          </div>
        </div>
        <div class="m-stat">
          <div class="m-stat-icon">📍</div>
          <div>
            <strong>Ruta piloto</strong>
            <span>Tramo destacado</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <section id="galeria-momentos" class="gallery-section">
    <div class="container">
      <!-- Filter Tags Bar -->
      <div class="filter-bar">
        <button class="filter-chip active">Todos</button>
        <button class="filter-chip">360°</button>
        <button class="filter-chip">Vídeo</button>
        <button class="filter-chip">Fotografía</button>
        <button class="filter-chip">Curvas</button>
        <button class="filter-chip">Altura</button>
        <button class="filter-chip">Bosque</button>
        <button class="filter-chip">Valle</button>
        <button class="filter-chip">Atardecer</button>
      </div>

      <!-- Masonry Grid -->
      <div class="masonry-grid">
        <!-- Item 1: 360 -->
        <div class="moment-card glass-panel" onclick="open360Modal('https://pannellum.org/images/cerro-toco.jpg', 'Curva sobre el valle')">
          <div class="moment-thumb">
            <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=600&q=80" alt="Curva sobre el valle" />
            <span class="badge badge-gold pos-tag">360°</span>
          </div>
          <div class="moment-info">
            <h3 class="m-title title-serif">Curva sobre el valle</h3>
            <p class="m-desc">Una curva amplia que revela todo el valle del Mantaro a tus pies.</p>

            <div class="m-meta">
              <span>📍 Ruta andina – Tramo piloto</span>
              <span>Selva Central</span>
            </div>
          </div>
        </div>

        <!-- Item 2: Video -->
        <div class="moment-card glass-panel">
          <div class="moment-thumb">
            <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=600&q=80" alt="Descenso andino" />
            <span class="badge badge-dark pos-tag">▶ Vídeo</span>
          </div>
          <div class="moment-info">
            <h3 class="m-title title-serif">Descenso andino</h3>
            <p class="m-desc">Curvas, quebradas y vistas que acompañan cada metro de descenso.</p>

            <div class="m-meta">
              <span>📍 Ruta andina – Tramo piloto</span>
              <span>Andes</span>
            </div>
          </div>
        </div>

        <!-- Item 3: Photo -->
        <div class="moment-card glass-panel">
          <div class="moment-thumb">
            <img src="https://images.unsplash.com/photo-1511497584788-8767611136f6?auto=format&fit=crop&w=600&q=80" alt="Bosque de eucaliptos" />
            <span class="badge badge-dark pos-tag">📷 Foto</span>
          </div>
          <div class="moment-info">
            <h3 class="m-title title-serif">Bosque de eucaliptos</h3>
            <p class="m-desc">Aromas, sombras y frescura en medio de la ruta.</p>

            <div class="m-meta">
              <span>📍 Ruta andina – Tramo piloto</span>
              <span>Selva Central</span>
            </div>
          </div>
        </div>

        <!-- Item 4: Tramo abierto -->
        <div class="moment-card glass-panel">
          <div class="moment-thumb">
            <img src="https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=600&q=80" alt="Tramo abierto" />
          </div>
          <div class="moment-info">
            <h3 class="m-title title-serif">Tramo abierto</h3>
            <p class="m-desc">Kilómetros de libertad entre montañas y horizontes lejanos.</p>

            <div class="m-meta">
              <span>📍 Ruta andina – Tramo piloto</span>
              <span>Pampa andina</span>
            </div>
          </div>
        </div>

        <!-- Item 5: Amanecer -->
        <div class="moment-card glass-panel">
          <div class="moment-thumb">
            <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=600&q=80" alt="Amanecer entre nubes" />
            <span class="badge badge-dark pos-tag">📷 Foto</span>
          </div>
          <div class="moment-info">
            <h3 class="m-title title-serif">Amanecer entre nubes</h3>
            <p class="m-desc">La niebla matinal convierte la ruta en un escenario mágico.</p>

            <div class="m-meta">
              <span>📍 Ruta andina – Tramo piloto</span>
              <span>3,200 m s.n.m.</span>
            </div>
          </div>
        </div>

        <!-- Item 6: Punto mas alto -->
        <div class="moment-card glass-panel">
          <div class="moment-thumb">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80" alt="Punto de mayor altitud" />
          </div>
          <div class="moment-info">
            <h3 class="m-title title-serif">Punto de mayor altitud</h3>
            <p class="m-desc">El aire se hace más delgado, el paisaje más inmenso.</p>

            <div class="m-meta">
              <span>📍 Ruta andina – Tramo piloto</span>
              <span>4,250 m s.n.m.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Timeline 5 Hitos -->
  <section class="section-hitos">
    <div class="container">
      <h2 class="section-title title-serif">Momentos del tramo piloto</h2>
      <p class="section-sub">Un recorrido lleno de experiencias que hacen única cada carretera.</p>

      <div class="hitos-timeline glass-panel">
        <div class="hito-step">
          <div class="step-num">1</div>
          <div class="step-thumb"><img src="https://images.unsplash.com/photo-1511497584788-8767611136f6?auto=format&fit=crop&w=300&q=80" alt="Inicio" /></div>
          <h4>Inicio en la Selva Central</h4>
          <span>Km 0 · 800 m s.n.m.</span>
        </div>

        <div class="hito-step">
          <div class="step-num">2</div>
          <div class="step-thumb"><img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=300&q=80" alt="Curvas" /></div>
          <h4>Curvas del Mantaro</h4>
          <span>Km 28 · 1,450 m s.n.m.</span>
        </div>

        <div class="hito-step">
          <div class="step-num">3</div>
          <div class="step-thumb"><img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=300&q=80" alt="Mirador" /></div>
          <h4>Mirador de Acopalca</h4>
          <span>Km 64 · 2,900 m s.n.m.</span>
        </div>

        <div class="hito-step">
          <div class="step-num">4</div>
          <div class="step-thumb"><img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=300&q=80" alt="Punto más alto" /></div>
          <h4>Punto más alto</h4>
          <span>Km 96 · 4,350 m s.n.m.</span>
        </div>

        <div class="hito-step">
          <div class="step-num">5</div>
          <div class="step-thumb"><img src="https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=300&q=80" alt="Descenso" /></div>
          <h4>Descenso a la sierra</h4>
          <span>Km 132 · 1,880 m s.n.m.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Author Quote Banner -->
  <section class="section-quote">
    <div class="container">
      <div class="quote-card glass-panel-gold">
        <div class="quote-avatar">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=300&q=80" alt="Aldo Jara" />
        </div>
        <div class="quote-content">
          <blockquote class="quote-text title-serif">
            "Las carreteras no solo se cruzan, se viven. Y los momentos, se guardan. Cada kilómetro trae algo que vale la pena recordar: un paisaje, una emoción, una pausa o simplemente el silencio de la altura."
          </blockquote>
          <span class="quote-author">Aldo Jara</span>
        </div>

        <div class="quote-stats">
          <div class="q-stat"><strong>+200</strong> Momentos capturados</div>
          <div class="q-stat"><strong>+80</strong> Experiencias 360°</div>
          <div class="q-stat"><strong>∞</strong> Recuerdos para siempre</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="section-cta">
    <div class="container">
      <div class="cta-card glass-panel">
        <div>
          <h3 class="cta-title title-serif">¿Listo para vivir la ruta completa?</h3>
          <p class="cta-sub">Explora todos los momentos, historias y experiencias del tramo piloto.</p>
        </div>
        <a href="/rutas/piloto" class="btn-gold">
          Entrar a la ruta →
        </a>
      </div>
    </div>
  </section>

  <!-- Pannellum Modal -->
  <div id="modal-360" class="modal-360-overlay">
    <div class="modal-360-content">
      <button class="modal-close" onclick="close360Modal()">✕ Cerrar</button>
      <h3 id="modal-title" class="title-serif text-gold">Visor Panorámico 360°</h3>
      <div id="panorama-container" class="panorama-box"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .momentos-hero {
    padding: 4rem 0 3rem;
  }

  .hero-title {
    font-size: 3rem;
    margin: 0.75rem 0;
  }

  .hero-sub {
    color: var(--text-sub);
    font-size: 1.1rem;
    max-width: 650px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .momentos-stats-bar {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: 1.25rem 2rem;
    gap: 1.5rem;
  }

  .m-stat {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .m-stat-icon {
    font-size: 1.5rem;
  }

  .m-stat strong {
    display: block;
    font-size: 0.95rem;
    color: var(--text-main);
  }

  .m-stat span {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* Gallery */
  .gallery-section {
    margin-bottom: 5rem;
  }

  .filter-bar {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .filter-chip {
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-sub);
    font-size: 0.85rem;
    transition: var(--transition-fast);
  }

  .filter-chip:hover, .filter-chip.active {
    background: var(--gold-subtle);
    border-color: var(--border-gold);
    color: var(--gold-primary);
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .moment-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .moment-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-gold);
  }

  .moment-thumb {
    position: relative;
    height: 200px;
  }

  .moment-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pos-tag { position: absolute; top: 0.75rem; left: 0.75rem; }

  .moment-info {
    padding: 1.25rem;
  }

  .m-title {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .m-desc {
    font-size: 0.82rem;
    color: var(--text-sub);
    line-height: 1.4;
    margin-bottom: 1rem;
  }

  .m-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--text-muted);
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  /* Timeline */
  .section-hitos {
    margin-bottom: 5rem;
  }

  .hitos-timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    padding: 2rem 1.5rem;
    margin-top: 1.5rem;
  }

  .hito-step {
    text-align: center;
    position: relative;
  }

  .step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--gold-primary);
    color: #000;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
  }

  .step-thumb {
    height: 90px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 0.75rem;
  }

  .step-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hito-step h4 {
    font-size: 0.88rem;
    margin-bottom: 0.25rem;
  }

  .hito-step span {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  /* Quote Card */
  .section-quote {
    margin-bottom: 5rem;
  }

  .quote-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    padding: 2.5rem;
    align-items: center;
  }

  .quote-avatar img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--gold-primary);
  }

  .quote-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-main);
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .quote-author {
    color: var(--gold-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .quote-stats {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 1px solid var(--border-subtle);
    padding-left: 2rem;
    font-size: 0.82rem;
    color: var(--text-sub);
  }

  .quote-stats strong {
    color: var(--gold-primary);
    font-size: 1.1rem;
  }

  /* CTA */
  .section-cta {
    margin-bottom: 6rem;
  }

  .cta-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2.5rem;
  }

  .cta-title {
    font-size: 1.6rem;
    margin-bottom: 0.3rem;
  }

  .cta-sub {
    color: var(--text-sub);
    font-size: 0.95rem;
  }

  /* 360 Modal */
  .modal-360-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 999;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .modal-360-overlay.open {
    display: flex;
  }

  .modal-360-content {
    position: relative;
    width: 100%;
    max-width: 1000px;
    background: var(--bg-dark);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--gold-primary);
    font-weight: 700;
    font-size: 1rem;
  }

  .panorama-box {
    width: 100%;
    height: 500px;
    border-radius: var(--radius-sm);
    margin-top: 1rem;
  }

  @media (max-width: 1024px) {
    .momentos-stats-bar { grid-template-columns: repeat(3, 1fr); }
    .masonry-grid { grid-template-columns: repeat(2, 1fr); }
    .hitos-timeline { grid-template-columns: repeat(3, 1fr); }
    .quote-card { grid-template-columns: 1fr; text-align: center; }
    .quote-stats { border-left: none; border-top: 1px solid var(--border-subtle); padding-left: 0; padding-top: 1rem; }
  }
</style>

<script is:inline>
  function open360Modal(imageSrc, title) {
    const modal = document.getElementById('modal-360');
    const titleEl = document.getElementById('modal-title');
    if (!modal) return;
    
    if (titleEl) titleEl.innerText = 'Panorama 360°: ' + title;
    modal.classList.add('open');

    if (window.pannellum) {
      window.pannellum.viewer('panorama-container', {
        type: 'equirectangular',
        panorama: imageSrc,
        autoLoad: true
      });
    }
  }

  function close360Modal() {
    const modal = document.getElementById('modal-360');
    if (modal) modal.classList.remove('open');
  }
</script>
